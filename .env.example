# Supabase project URL. Locally this is printed by `npx supabase start` (API URL).
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon (publishable) key. Locally: `npx supabase status` -> "anon key" / "Publishable key".
VITE_SUPABASE_ANON_KEY=replace-me
# Web Push public (VAPID) key. Generate a pair with `npx web-push generate-vapid-keys`;
# the private half goes in the send-push function's secrets. Leave empty to hide push.
VITE_VAPID_PUBLIC_KEY=
